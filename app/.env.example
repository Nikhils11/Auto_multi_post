# Bluesky
BLUESKY_USERNAME=your-handle.bsky.social
BLUESKY_PASSWORD=your-bluesky-app-password
BLUESKY_DID=did:plc:replace-with-your-did
BLUESKY_SESSION_URL=https://bsky.social/xrpc/com.atproto.server.createSession
BLUESKY_POST_URL=https://bsky.social/xrpc/com.atproto.repo.createRecord
BLUESKY_MESSAGE_URL=https://bsky.app/profile/your-handle.bsky.social/post/

# Mastodon (set the URLs for your instance)
MASTODON_USERNAME=your-mastodon-username
MASTODON_ACCESS_TOKEN=replace-with-your-mastodon-access-token
MASTODON_POST_URL=https://mastodon.social/api/v1/statuses

# DEV Community
DEVTO_USERNAME=your-devto-username
DEVTO_API_KEY=replace-with-your-devto-api-key
DEVTO_POST_URL=https://dev.to/api/articles

# GitHub Gist
GIST_PAT_TOKEN=replace-with-your-github-personal-access-token
GIST_POST_URL=https://api.github.com/gists

# Telegram
TELEGRAM_API_TOKEN=replace-with-your-telegram-bot-token
TELEGRAM_BASE_URL=https://api.telegram.org/
TELEGRAM_CHANNEL_URL=https://t.me/your-channel/
TELEGRAM_CHANNEL_ID=@your_channel
